// () — условие: блок выполняется ОДИН РАЗ, если в ячейке цифра (48-57, символы '0'-'9')
// Важно: :N прибавляет N, ;N вычитает N (это не присваивание!)

// --- Простое условие ---
:52(.)      // 52 = '4' — цифра, блок выполнится, напечатает '4'
:81(.)      // 52 + 81 = 133 — не цифра, блок пропущен
;133        // в ячейке 133 — обнуляем

// значение в ячейке 0, счётчик в ячейке 1, указатель стоит на счётчике

// --- Печатаем чётные цифры: 0 2 4 6 8 ---
:48>:5
[
  <(. :2)>;1
]

// счётчик обнулился сам, в ячейке 0 осталось 58 — обнуляем и задаём 49
<;58:49>:5

// --- Печатаем нечётные цифры: 1 3 5 7 9 ---
[
  <(. :2)>;1
]