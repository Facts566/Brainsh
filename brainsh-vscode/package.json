{
    "name": "brainsh",
    "displayName": "Brainsh",
    "description": "Syntax highlighting for the Brainsh esoteric language",
    "version": "0.1.0",
    "publisher": "Facts566",
    "license": "MIT",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": ["Programming Languages"],
    "keywords": ["brainsh", "brainfuck", "esoteric", "language"],
    "icon": "brainsh.png",
    "galleryBanner": {
        "color": "#1F4E9C",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Facts566/Brainsh.git"
    },
    "bugs": {
        "url": "https://github.com/Facts566/Brainsh/issues"
    },
    "homepage": "https://github.com/Facts566/Brainsh#readme",
    "contributes": {
        "languages": [
            {
                "id": "brainsh",
                "aliases": ["Brainsh", "brainsh"],
                "extensions": [".bsh"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./brainsh.png",
                    "dark": "./brainsh.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "brainsh",
                "scopeName": "source.brainsh",
                "path": "./syntaxes/brainsh.tmLanguage.json"
            }
        ]
    }
}