{
  "name": "Brainsh",
  "scopeName": "source.brainsh",
  "patterns": [
    { "include": "#comments" },
    { "include": "#include" },
    { "include": "#macros" },
    { "include": "#keywords" },
    { "include": "#io" },
    { "include": "#movement" },
    { "include": "#math" },
    { "include": "#random" },
    { "include": "#digits" },
    { "include": "#loops" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#comment" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.brainsh",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comment" }
          ]
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.brainsh",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "keyword.operator.assignment.brainsh",
          "match": "="
        }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.brainsh",
        "match": "[NSd]"
      }]
    },
    "io": {
      "patterns": [{
        "name": "support.function.brainsh",
        "match": "[#.,]"
      }]
    },
    "movement": {
      "patterns": [{
        "name": "keyword.operator.movement.brainsh",
        "match": "[<>]"
      }]
    },
    "math": {
      "patterns": [
        {
          "name": "keyword.operator.repeat.brainsh",
          "match": "[:;]"
        },
        {
          "name": "keyword.operator.math.brainsh",
          "match": "[+\\-m]"
        }
      ]
    },
    "random": {
      "patterns": [{
        "name": "support.function.random.brainsh",
        "match": "r"
      }]
    },
    "include": {
      "patterns": [
        {
          "match": "(%)([^\"\\s]*|\"[^\"]*\")",
          "captures": {
            "1": { "name": "punctuation.definition.include.brainsh" },
            "2": { "name": "string.unquoted.include.brainsh" }
          }
        }
      ]
    },
    "digits": {
      "patterns": [{
        "name": "constant.numeric.brainsh",
        "match": "[0-9]"
      }]
    },
    "loops": {
      "patterns": [
        {
          "name": "punctuation.definition.loop.brainsh",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.condition.brainsh",
          "match": "[\\(\\)]"
        }
      ]
    }
  }
}